/* =========================================================
   DRIVER DISTRACTION DETECTION - CYBERPUNK HUD DESIGN SYSTEM
   ========================================================= */

QMainWindow, QWidget {
    background-color: #07090E;
    color: #F8FAFC;
    font-family: "Segoe UI", "SF Pro Display", -apple-system, sans-serif;
    font-size: 13px;
}

/* =========================================================
   HEADER & TITLE
   ========================================================= */

#appHeader {
    background: transparent;
    padding-bottom: 4px;
}

#title {
    background: transparent;
    color: #F8FAFC;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 1px;
}

#subtitle {
    background: transparent;
    color: #64748B;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
}

#activeStatus {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    border-radius: 16px;
    color: #10B981;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 16px;
    letter-spacing: 0.8px;
}

#activeStatus[state="CALIBRATING"] {
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.35);
    color: #F59E0B;
}

#activeStatus[state="PAUSED"] {
    background: rgba(234, 179, 8, 0.12);
    border-color: rgba(234, 179, 8, 0.35);
    color: #EAB308;
}

#activeStatus[state="ALERT"] {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.45);
    color: #FF2E55;
}


/* =========================================================
   CAMERA & HUD CONTAINER
   ========================================================= */

#cameraPanel {
    background: #0B101D;
    border: 1px solid #1E293B;
    border-radius: 16px;
}

#cameraPlaceholder {
    background: #050811;
    border-radius: 12px;
    color: #475569;
    font-size: 14px;
    font-weight: 600;
}

#hudOverlayFrame {
    background: transparent;
    border: none;
}


/* =========================================================
   CONTROL BAR & BUTTONS
   ========================================================= */

#controlBar {
    background: #0D1322;
    border: 1px solid #1E293B;
    border-radius: 14px;
    padding: 6px 12px;
}

#iconButton {
    background: #0F172A;
    border: 1px solid #334155;
    border-radius: 10px;
    min-width: 44px;
    min-height: 44px;
    max-width: 44px;
    max-height: 44px;
}

#iconButton:hover {
    background: #1E293B;
    border-color: #38BDF8;
}

#iconButton:pressed {
    background: #0284C7;
    border-color: #38BDF8;
}

#recalibrateButton {
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 10px;
    color: #38BDF8;
    font-size: 12px;
    font-weight: 700;
    padding: 0px 16px;
    min-height: 44px;
    max-height: 44px;
}

#recalibrateButton:hover {
    background: rgba(56, 189, 248, 0.2);
    border-color: #38BDF8;
    color: #F8FAFC;
}

#recalibrateButton:pressed {
    background: #0284C7;
    color: #FFFFFF;
}

#exitIconButton {
    background: #2A1215;
    border: 1px solid #7F1D1D;
    border-radius: 10px;
    min-width: 44px;
    min-height: 44px;
    max-width: 44px;
    max-height: 44px;
}

#exitIconButton:hover {
    background: #451A1D;
    border-color: #EF4444;
}

#exitIconButton:pressed {
    background: #991B1B;
    border-color: #FCA5A5;
}


/* =========================================================
   RIGHT DASHBOARD PANEL
   ========================================================= */

#dashboard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0D1322, stop:1 #080C16);
    border: 1px solid #1E293B;
    border-radius: 16px;
}

#sectionTitle {
    background: transparent;
    color: #64748B;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
}


/* =========================================================
   STATUS HERO CARD
   ========================================================= */

#statusCard {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid #1E293B;
    border-radius: 14px;
    padding: 16px;
}

#statusCard[status="ATTENTIVE"] {
    border: 1px solid rgba(16, 185, 129, 0.4);
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(16, 185, 129, 0.08), stop:1 rgba(15, 23, 42, 0.9));
}

#statusCard[status="DROWSY"],
#statusCard[status="DISTRACTED - LEFT"],
#statusCard[status="DISTRACTED - RIGHT"],
#statusCard[status="DROWSY + DISTRACTED"] {
    border: 1px solid rgba(239, 68, 68, 0.5);
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(239, 68, 68, 0.12), stop:1 rgba(15, 23, 42, 0.9));
}

#statusCard[status="CALIBRATING"] {
    border: 1px solid rgba(245, 158, 11, 0.4);
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(245, 158, 11, 0.08), stop:1 rgba(15, 23, 42, 0.9));
}

#systemStatus {
    background: transparent;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

#systemStatus[status="ATTENTIVE"] {
    color: #00F59B;
}

#systemStatus[status="NO FACE"] {
    color: #94A3B8;
}

#systemStatus[status="DROWSY"],
#systemStatus[status="DISTRACTED - LEFT"],
#systemStatus[status="DISTRACTED - RIGHT"],
#systemStatus[status="DROWSY + DISTRACTED"] {
    color: #FF2E55;
}

#systemStatus[status="CALIBRATING"] {
    color: #F59E0B;
}

#statusSubtitle {
    background: transparent;
    color: #94A3B8;
    font-size: 12px;
    font-weight: 600;
}


/* =========================================================
   METRIC CARDS (EAR & YAW)
   ========================================================= */

#metricCard {
    background: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 12px;
}

#metricName {
    background: transparent;
    color: #64748B;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

#metricValue {
    background: transparent;
    color: #F8FAFC;
    font-size: 20px;
    font-weight: 700;
}

#metricState {
    background: transparent;
    color: #38BDF8;
    font-size: 11px;
    font-weight: 700;
}


/* =========================================================
   VISUAL METER / BAR GAUGE
   ========================================================= */

QProgressBar#visualMeter {
    background: #1E293B;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#visualMeter::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #38BDF8, stop:1 #00F59B);
    border-radius: 4px;
}

QProgressBar#visualMeter[meterType="EAR_WARNING"]::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #EF4444, stop:1 #F59E0B);
}

QProgressBar#visualMeter[meterType="YAW"]::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8B5CF6, stop:1 #38BDF8);
}


/* =========================================================
   ALARM BADGE
   ========================================================= */

#alarm {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid #1E293B;
    border-radius: 8px;
    color: #94A3B8;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
}

#alarm[muted="true"] {
    color: #EF4444;
    border-color: rgba(239, 68, 68, 0.3);
}


/* =========================================================
   DURATION CARDS
   ========================================================= */

QFrame#durationCard {
    background: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 12px;
}

QLabel#durationName {
    background: transparent;
    color: #64748B;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

QLabel#durationValue {
    background: transparent;
    color: #38BDF8;
    font-size: 22px;
    font-weight: 800;
}


/* =========================================================
   CALIBRATION OVERLAY
   ========================================================= */

#calibrationWidget {
    background: #0B101D;
    border: 1px solid #3B82F6;
    border-radius: 14px;
}

#calibrationTitle {
    background: transparent;
    color: #38BDF8;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
}

#calibrationIcon {
    background: transparent;
    color: #F59E0B;
    font-size: 36px;
}

#calibrationInstruction {
    background: transparent;
    color: #F8FAFC;
    font-size: 18px;
    font-weight: 800;
}

#calibrationDescription {
    background: transparent;
    color: #94A3B8;
    font-size: 12px;
    line-height: 1.4;
}

#calibrationState {
    background: transparent;
    color: #F59E0B;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
}

QProgressBar#calibrationProgress {
    background: #1E293B;
    border: none;
    border-radius: 5px;
    min-height: 10px;
    max-height: 10px;
}

QProgressBar#calibrationProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #F59E0B, stop:1 #38BDF8);
    border-radius: 5px;
}